# ============================================================
# YouSee360 — Apache config for Hostinger
# Compression, browser caching, security headers, HTTPS, SPA-free
# ============================================================

# Default index
DirectoryIndex index.html

# ============================================================
# 1. HTTPS REDIRECT
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?yousee360\.com$ [NC]
  RewriteRule ^(.*)$ https://yousee360.com/$1 [R=301,L]
  # Strip www
  RewriteCond %{HTTP_HOST} ^www\.yousee360\.com$ [NC]
  RewriteRule ^(.*)$ https://yousee360.com/$1 [R=301,L]
  # Remove trailing index.html
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^?\s]*/)?index\.html [NC]
  RewriteRule ^(([^/]+/)*)index\.html$ /$1 [R=301,L]
</IfModule>

# ============================================================
# 1b. WEBP CONTENT NEGOTIATION
# Serve foo.webp instead of foo.jpg/png when the browser accepts
# WebP and a .webp twin exists on disk. No HTML changes required.
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} (?i)^(.+)\.(jpe?g|png)$
  RewriteCond %1.webp -f
  RewriteRule (?i)^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=WEBP_SERVED:1,L]
</IfModule>

<IfModule mod_headers.c>
  # Caches must key on Accept, or a WebP response can be served to a client
  # that cannot render it. Two rules are needed: FilesMatch sees the file that
  # is finally served, so after the rewrite it matches .webp and never the
  # original .jpg -- the env flag set on the RewriteRule covers that case.
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>
  Header append Vary Accept env=WEBP_SERVED
</IfModule>

# ============================================================
# 2. COMPRESSION (gzip + brotli where available)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ============================================================
# 3. BROWSER CACHING (Expires + Cache-Control)
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — short cache so updates roll out
  ExpiresByType text/html                     "access plus 1 hour"
  ExpiresByType application/xhtml+xml         "access plus 1 hour"

  # XML / sitemap — short
  ExpiresByType application/xml               "access plus 1 day"
  ExpiresByType text/xml                      "access plus 1 day"

  # CSS / JS — long
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType application/x-javascript      "access plus 1 year"

  # Images — long
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon      "access plus 1 year"

  # Fonts — long
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"
  ExpiresByType application/x-font-ttf        "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Video
  ExpiresByType video/mp4                     "access plus 1 year"
  ExpiresByType video/webm                    "access plus 1 year"

  # JSON-LD / manifest
  ExpiresByType application/json              "access plus 1 hour"
  ExpiresByType application/ld+json           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # CSS / JS / fonts / images — immutable for a year
  <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — must-revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # ============================================================
  # 4. SECURITY HEADERS
  # ============================================================
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The 360 tours are embedded from tour subdomains and ask for motion sensors
  # via allow="accelerometer; gyroscope; xr-spatial-tracking; fullscreen".
  # Those features default to a self-only allowlist, so without delegation the
  # browser blocks them and the "move your phone to look around" gesture stops
  # working inside every embedded tour.
  # Uses * rather than a quoted origin list: LiteSpeed emits backslash-escaped
  # quotes literally, which makes the whole header fail the structured-header
  # parser and voids every restriction in it, including camera and microphone.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), accelerometer=*, gyroscope=*, magnetometer=*, xr-spatial-tracking=*, fullscreen=*"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # Remove ETag (using Last-Modified instead via Expires)
  Header unset ETag
  FileETag None
</IfModule>

# ============================================================
# 5. MIME TYPES (some hosts don't recognize all)
# ============================================================
<IfModule mod_mime.c>
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType image/svg+xml                     .svg .svgz
  AddType font/woff                         .woff
  AddType font/woff2                        .woff2
  AddType application/manifest+json         .webmanifest
  AddType application/ld+json               .jsonld
  AddType video/mp4                         .mp4
  AddType video/webm                        .webm
</IfModule>

# ============================================================
# 6. CUSTOM 404
# ============================================================
ErrorDocument 404 /404.html

# ============================================================
# 7. PREVENT HOTLINKING (optional — comment out if you want OG images served everywhere)
# ============================================================
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_REFERER} !^$
#   RewriteCond %{HTTP_REFERER} !^https?://(www\.)?yousee360\.com [NC]
#   RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?google\. [NC]
#   RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?bing\. [NC]
#   RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?facebook\. [NC]
#   RewriteRule \.(jpe?g|png|gif|webp)$ - [F,NC]
# </IfModule>

# ============================================================
# 8. BLOCK ACCESS TO SENSITIVE FILES
# ============================================================
<FilesMatch "(^\.|composer\.|package\.|README|\.env|\.git)">
  Require all denied
</FilesMatch>

Options -Indexes
